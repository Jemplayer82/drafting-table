# Copy to .env (gitignored) and fill in real values.
# See the plan doc for why several of these are files, not inline values:
# with an unauthenticated Portainer API on this LAN, stack env vars are
# readable by anyone who can reach it — secrets below should be mounted
# as files, not passed as plain compose environment values in production.

# --- Admin login (required — app refuses to start without both) ---
# Generate with: uv run python -m hashpw
ADMIN_USER=changeme
ADMIN_PASSWORD_HASH=changeme

# --- Session / CSRF signing ---
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=changeme

# --- Claude Code headless auth ---
# Generate with: claude setup-token (see plan doc — NOT an API key)
CLAUDE_CODE_OAUTH_TOKEN=changeme

# --- App ---
DT_PORT=8093
DATA_DIR=/data
MEDIA_DIR=/media
